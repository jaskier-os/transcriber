# --- Core ---
# Authentication token clients must send as "Authorization: Bearer <key>"
# (or "x-api-key" for streaming). REQUIRED. Generate a long random string.
API_KEY=change-me

# faster-whisper model name or local path (e.g. "large-v3", "medium",
# "Systran/faster-whisper-large-v3"). Downloaded from Hugging Face on first run.
WHISPER_MODEL=large-v3
# Inference device: "cpu" or "cuda"/"gpu".
DEVICE=cpu
# CTranslate2 compute type, e.g. int8 (cpu), float16 or int8_float16 (cuda).
COMPUTE_TYPE=int8
# Whisper decoding beam size (1 = greedy, fastest).
BEAM_SIZE=1
# Forced decode language code (e.g. "ru", "en"); leave empty to auto-detect.
LANGUAGE=
# CPU thread count for inference (0 = library default).
CPU_THREADS=0
# HTTP/WebSocket listen port.
PORT=10003

# --- Speaker verification (optional) ---
# Enable per-device speaker gating with SpeechBrain ECAPA-TDNN.
SPEAKER_ENABLED=false
# Cosine-similarity threshold for accepting a speaker.
SPEAKER_THRESHOLD=0.45
# Directory holding {device_id}.npy speaker profiles (see enroll.py).
SPEAKER_PROFILES_DIR=./profiles

# --- Streaming / VAD ---
STREAMING_VAD_THRESHOLD=0.5
STREAMING_MIN_CHUNK_SIZE=1.0
STREAMING_SILENCE_THRESHOLD=3.0
STREAMING_SENTENCE_SILENCE=1.5

# --- Optional integrations ---
# Translator service base URL for streaming translation. Plain http needs no cert.
TRANSLATOR_URL=http://localhost:10015
# Outbound orchestrator WebSocket URL. Leave empty to disable the bridge.
# Example: wss://orchestrator.example.com:8443/ws/transcriber
ORCHESTRATOR_WS_URL=
# Optional path to write raw PCM of streamed audio for debugging. Empty = off.
AUDIO_DUMP_PATH=

# --- Optional TLS ---
# Path to a custom CA bundle (PEM) for verifying TLS to the orchestrator/translator.
# Leave unset to use the system CA store. Not required for plain (http/ws) endpoints.
TLS_CERT_PATH=
